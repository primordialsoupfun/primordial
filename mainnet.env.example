# Mainnet env for Render. NOT applied. Set at launch (00:00 Taipei / 16:00 UTC Oct 22) only after approval.
CLUSTER=mainnet-beta
ALLOW_MAINNET=1
RPC=https://<paid-mainnet-rpc>          # Helius/QuickNode etc; public api.mainnet-beta is rate-limited
TREASURY_SECRET=<mainnet treasury key>   # this wallet's pubkey MUST equal the pump.fun creator-fee recipient
SOUP_MINT=<SOUP_MINT_CA_FROM_PUMP_FUN>   # fill the moment the coin is created; server polls every 60s until set
BURN_ENABLED=0                           # dry-run burn uses treasury test tokens; keep off on mainnet
FREE_RELEASE_OPEN=0                      # flip to 1 at launch only with explicit go
# Remove MOCK_RATE / devnet-only overrides. Keep DATA_DIR on the persistent disk.
