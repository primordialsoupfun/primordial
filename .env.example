# Server-side Solana RPC. Devnet or localnet only; mainnet is refused by this build.
RPC=https://api.devnet.solana.com
CLUSTER=devnet
# Treasury keypair as a JSON byte array. Set as a secret in your host. Never commit it.
TREASURY_SECRET=
TICKER=SOUP
PUBLIC_URL=https://primordialsoup.fun
DATA_DIR=./data
EPOCH_TICKS=3000
PRIZE_SHARE=0.2
BURN_INTERVAL_S=86400
COMMIT_TICKS=1500
